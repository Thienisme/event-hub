# Múi giờ nghiệp vụ của ứng dụng.
#
# Vite chỉ expose các biến có tiền tố VITE_ sang code trong src/ (biến không
# có tiền tố sẽ không bao giờ tới được client). Vì vậy ở đây phải dùng
# VITE_APP_TIMEZONE chứ không phải APP_TIMEZONE.
#
# Mọi thời gian đều được lưu ở UTC trong DB và hiển thị theo múi giờ này, nên
# kết quả không đổi dù máy người dùng đặt ở múi giờ nào.
VITE_APP_TIMEZONE=Asia/Ho_Chi_Minh
