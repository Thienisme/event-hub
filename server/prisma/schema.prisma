datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(CUSTOMER)
  // Tài khoản bị khoá: không đăng nhập được, và token đang cầm cũng mất tác dụng.
  isActive  Boolean  @default(true)
  // Mốc thay đổi role. Dùng để biết token đã cấp còn hợp lệ hay không.
  roleChangedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]  @relation("OrganizerEvents")
  orders    Order[]
  auditLogs AdminAuditLog[] @relation("AuditActor")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// Nhật ký thao tác quản trị: ai làm gì lên ai, lúc nào.
model AdminAuditLog {
  id      String  @id @default(uuid())
  // actorId CÓ THỂ null: khi tài khoản admin bị xoá, nhật ký vẫn phải được giữ
  // lại (đó là mục đích của nhật ký). `onDelete: SetNull` cho phép xoá user mà
  // không phá vỡ lịch sử.
  actorId String?
  // Ảnh chụp email của người thực hiện tại thời điểm ghi. Nhật ký tồn tại lâu
  // hơn tài khoản, nên phải lưu kèm thông tin nhận diện để đọc lại vẫn hiểu
  // "ai đã làm" ngay cả khi user đã bị xoá.
  actorEmail String
  action     String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Event {
  id          String   @id @default(uuid())
  // Độ dài cột được đặt tường minh thay vì để Prisma mặc định VARCHAR(191).
  //
  // VARCHAR(191) là HỆ QUẢ của giới hạn index utf8mb4 (191 * 4 = 764 byte < 767),
  // KHÔNG phải một quyết định thiết kế. Nhưng khi mọi cột chuỗi đều dừng ở 191
  // ký tự thì một mô tả dài hơn 191 ký tự sẽ chết ở tầng DB với lỗi 500 chung
  // chung, thay vì 400 kèm thông báo rõ ràng. Ta chọn độ dài vừa đủ cho nội dung
  // thực tế và KHỚP với giới hạn ở tầng validation (xem utils/validation.ts).
  title       String   @db.VarChar(255)
  // Mô tả sự kiện là nội dung dài, không có lý do gì cắt cụt ở 191 ký tự.
  description String?  @db.Text
  location    String   @db.VarChar(255)
  bannerUrl   String?  @db.VarChar(500)
  startTime   DateTime
  endTime     DateTime
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer   User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketTypes TicketType[]

  @@map("events")
}

model TicketType {
  id          String   @id @default(uuid())
  eventId     String
  name        String   @db.VarChar(100)
  // DECIMAL(12,2): tối đa 9.999.999.999,99 — đủ cho giá vé VNĐ, và khớp với
  // thang của orders.totalAmount (xem model Order).
  price       Decimal  @db.Decimal(12, 2)
  totalQuantity Int
  availableQuantity Int
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@map("ticket_types")
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  // Thang tiền phải khớp với ticket_types.price, nếu không một đơn mua vé đắt
  // sẽ không lưu được vào bảng orders.
  totalAmount  Decimal     @db.Decimal(12, 2)
  status       OrderStatus @default(PENDING)
  expiresAt    DateTime?   // Giữ chỗ trong 10 phút
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  tickets      Ticket[]

  @@map("orders")
}

model Ticket {
  id           String     @id @default(uuid())
  orderId      String
  ticketTypeId String
  qrCode       String?    @unique
  createdAt    DateTime   @default(now())

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@map("tickets")
}