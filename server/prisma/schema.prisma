datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

enum EventCategory {
  MUSIC
  SPORTS
  CONFERENCE
  WORKSHOP
  THEATER
  EXHIBITION
  FESTIVAL
  FOOD
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  avatarUrl String? @db.VarChar(191)
  role      Role     @default(CUSTOMER)
  // Tài khoản bị khoá: không đăng nhập được, và token đang cầm cũng mất tác dụng.
  isActive  Boolean  @default(true)
  // Mốc thay đổi role. Dùng để biết token đã cấp còn hợp lệ hay không.
  roleChangedAt DateTime?
  // Phiên bản token. JWT mang theo `tv` lúc cấp; đổi mật khẩu thì tăng số này
  // nên mọi token cấp trước đó mất hiệu lực ngay (authenticate so sánh hai số).
  tokenVersion Int @default(0)
  emailVerifiedAt DateTime? @db.DateTime(3)
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    Event[]  @relation("OrganizerEvents")
  waitlistEntries WaitlistEntry[]
  orders    Order[]
  auditLogs AdminAuditLog[] @relation("AuditActor")
  checkedInTickets Ticket[] @relation("TicketCheckedInBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// Nhật ký thao tác quản trị: ai làm gì lên ai, lúc nào.
model AdminAuditLog {
  id      String  @id @default(uuid())
  // actorId CÓ THỂ null: khi tài khoản admin bị xoá, nhật ký vẫn phải được giữ
  // lại (đó là mục đích của nhật ký). `onDelete: SetNull` cho phép xoá user mà
  // không phá vỡ lịch sử.
  actorId String?
  // Ảnh chụp email của người thực hiện tại thời điểm ghi. Nhật ký tồn tại lâu
  // hơn tài khoản, nên phải lưu kèm thông tin nhận diện để đọc lại vẫn hiểu
  // "ai đã làm" ngay cả khi user đã bị xoá.
  actorEmail String
  action     String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model Event {
  id          String   @id @default(uuid())
  // Độ dài cột được đặt tường minh thay vì để Prisma mặc định VARCHAR(191).
  //
  // VARCHAR(191) là HỆ QUẢ của giới hạn index utf8mb4 (191 * 4 = 764 byte < 767),
  // KHÔNG phải một quyết định thiết kế. Nhưng khi mọi cột chuỗi đều dừng ở 191
  // ký tự thì một mô tả dài hơn 191 ký tự sẽ chết ở tầng DB với lỗi 500 chung
  // chung, thay vì 400 kèm thông báo rõ ràng. Ta chọn độ dài vừa đủ cho nội dung
  // thực tế và KHỚP với giới hạn ở tầng validation (xem utils/validation.ts).
  slug        String   @unique @db.VarChar(191)
  title       String   @db.VarChar(255)
  // Mô tả sự kiện là nội dung dài, không có lý do gì cắt cụt ở 191 ký tự.
  description String?  @db.Text
  location    String   @db.VarChar(255)
  category    EventCategory @default(OTHER)
  bannerUrl   String?  @db.VarChar(500)
  startTime   DateTime
  endTime     DateTime
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer   User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  promoCodes PromoCode[]

  @@index([createdAt])
  @@index([category, startTime])
  @@map("events")
}

model TicketType {
  id          String   @id @default(uuid())
  eventId     String
  name        String   @db.VarChar(100)
  // DECIMAL(12,2): tối đa 9.999.999.999,99 — đủ cho giá vé VNĐ, và khớp với
  // thang của orders.totalAmount (xem model Order).
  price       Decimal  @db.Decimal(12, 2)
  totalQuantity Int
  saleStart DateTime? @db.DateTime(3)
  saleEnd DateTime? @db.DateTime(3)
  availableQuantity Int
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  waitlistEntries WaitlistEntry[]
  tickets     Ticket[]

  @@map("ticket_types")
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  // Thang tiền phải khớp với ticket_types.price, nếu không một đơn mua vé đắt
  // sẽ không lưu được vào bảng orders.
  totalAmount  Decimal     @db.Decimal(12, 2)
  subtotalAmount Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  promoCodeId String?
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  status       OrderStatus @default(PENDING)
  reminderSentAt DateTime? @db.DateTime(3)
  expiresAt    DateTime?   // Giữ chỗ trong 10 phút
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  payments     Payment[]
  tickets      Ticket[]

  @@index([promoCodeId, userId, status])
  @@index([status, expiresAt])
  @@index([status, reminderSentAt])
  @@map("orders")
}

model Ticket {
  id           String     @id @default(uuid())
  orderId      String
  ticketTypeId String
  qrCode       String?    @unique
  // Thời điểm soát vé ở cổng. NULL = chưa check-in. Chỉ đổi từ NULL sang có giá
  // trị bằng `updateMany` có điều kiện `checkedInAt: null` (xem checkin.controller).
  checkedInAt  DateTime?
  // Người quét vé. SetNull: xoá tài khoản nhân viên không được làm mất lịch sử soát vé.
  checkedInById String?
  createdAt    DateTime   @default(now())

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  checkedInBy  User?      @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([checkedInById])

  @@map("tickets")
}

// Lưu ảnh trong database vì ổ đĩa của Render free không bền vững.
model StoredFile {
  name      String   @id @db.VarChar(64)
  mime      String   @db.VarChar(32)
  size      Int
  data      Bytes    @db.MediumBlob
  createdAt DateTime @default(now())

  @@map("stored_files")
}

model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  usedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id String @id @default(uuid())
  userId String
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  usedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

enum DiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id String @id @default(uuid())
  eventId String
  code String @db.VarChar(32)
  discountType DiscountType
  discountValue Decimal @db.Decimal(12, 2)
  maxUses Int?
  usedCount Int @default(0)
  perUserLimit Int @default(1)
  startsAt DateTime?
  endsAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([eventId, code])
  @@map("promo_codes")
}

enum PaymentProvider {
  MOCK
  VNPAY
  MOMO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Payment {
  id String @id @default(uuid())
  orderId String
  provider PaymentProvider
  txnRef String @unique @db.VarChar(20)
  amount Decimal @db.Decimal(12, 2)
  status PaymentStatus @default(PENDING)
  providerTransactionId String? @db.VarChar(191)
  needsRefund Boolean @default(false)
  createdAt DateTime @default(now())
  paidAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model WaitlistEntry {
  id String @id @default(uuid())
  ticketTypeId String
  userId String
  createdAt DateTime @default(now()) @db.DateTime(3)
  notifiedAt DateTime? @db.DateTime(3)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketTypeId, userId])
  @@index([ticketTypeId, notifiedAt, createdAt])
  @@index([userId])
  @@map("waitlist_entries")
}
