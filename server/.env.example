# Database Configuration
# Replace with your MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Server Port
PORT=5000

# Múi giờ nghiệp vụ.
#
# Node KHÔNG có date_default_timezone_set như PHP, nên để cố định múi giờ
# phải đặt biến môi trường TZ (Node đọc lúc khởi động process). Mọi thời gian
# vẫn được lưu ở UTC trong DB; TZ chỉ quyết định cách server hiển thị/so
# sánh ngày tháng trong log và các truy vấn theo ngày.
TZ=Asia/Ho_Chi_Minh

# CORS - danh sách origin của frontend được phép gọi API, phân tách bằng dấu phẩy.
#
# BỎ TRỐNG (hoặc xoá hẳn dòng này) -> dùng danh sách mặc định: các cổng
# 5173-5176 của localhost và 127.0.0.1 (Vite tự nhảy cổng khi cổng đang bận).
#
# ⚠️ Dùng đường DẪN ĐẦY ĐỦ, gồm cả scheme và cổng. Nếu ghi sai (thiếu
# "http://", thiếu cổng) thì origin không khớp -> trình duyệt báo lỗi CORS dù
# server đã chạy đúng.
#
# Khi server khởi động, log in ra danh sách origin đang được phép — thấy dòng
# "🌐 CORS allowed origins:" là cách nhanh nhất để kiểm tra origin này có trong
# whitelist hay không.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176"

# JWT Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_jwt_secret_here_minimum_32_characters_long"

# Redis Configuration (optional - defaults to localhost:6379)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# Order Configuration (optional - defaults shown)
ORDER_HOLD_MINUTES=10
ORDER_SWEEP_INTERVAL_MS=60000