# Database Configuration
# Replace with your MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# Server Port
PORT=5000

# JWT Configuration
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_jwt_secret_here_minimum_32_characters_long"

# Redis Configuration (optional - defaults to localhost:6379)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# Order Configuration (optional - defaults shown)
ORDER_HOLD_MINUTES=10
ORDER_SWEEP_INTERVAL_MS=60000