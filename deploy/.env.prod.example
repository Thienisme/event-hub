# GIÁ TRỊ GIẢ, thay tất cả secret trước khi chạy. Không commit .env.prod.
# Sinh riêng từng secret: openssl rand -hex 32
# Dùng hex cho password MySQL để an toàn khi ghép DATABASE_URL.
DOMAIN=1-2-3-4.sslip.io
MYSQL_ROOT_PASSWORD=FAKE_REPLACE_WITH_RANDOM_HEX
MYSQL_DATABASE=eventhub
JWT_SECRET=FAKE_REPLACE_WITH_SEPARATE_RANDOM_HEX_32_BYTES
SEED_DEMO_PASSWORD=FAKE_REPLACE_WITH_ANOTHER_RANDOM_HEX
# Thay cùng hostname với DOMAIN, không có dấu / cuối.
CORS_ORIGINS=https://1-2-3-4.sslip.io
TZ=Asia/Ho_Chi_Minh
# CD chọn sha-xxxxxxx; lần đầu có thể dùng latest.
IMAGE_TAG=latest
# Chỉ có tác dụng với compose local; deploy bỏ build và publish client.
VITE_API_BASE_URL=/api
WEB_PORT=8081
