# File mẫu, KHÔNG dùng nguyên giá trị mẫu cho demo public.
# Chạy riêng openssl rand -hex 32 ba lần rồi điền ba giá trị khác nhau.
# MySQL dùng hex để ghép DATABASE_URL an toàn; JWT cần ít nhất 32 ký tự.
# MYSQL_ROOT_PASSWORD và JWT_SECRET là toàn bộ biến :? trong compose gốc.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Override yêu cầu thêm mật khẩu cho tài khoản seed demo.
SEED_DEMO_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# latest theo bản build mới; sha-xxxxxxx để giữ một phiên bản cụ thể.
IMAGE_TAG=latest
TZ=Asia/Ho_Chi_Minh
# Client và API cùng origin qua nginx nên CORS không ảnh hưởng luồng này.
# Chỉ cần một origin hợp lệ; không phải sửa theo link tunnel ngẫu nhiên.
CORS_ORIGINS=http://localhost
